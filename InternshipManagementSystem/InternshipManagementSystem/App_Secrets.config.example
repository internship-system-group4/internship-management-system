<?xml version="1.0" encoding="utf-8"?>
<!--
  No longer needed. The Firebase database URL and Web API key are now in
  Web.config, so the whole team gets them with git pull.
  Do not put any settings in this file.
-->
<appSettings>
  <add key="Firebase.DatabaseUrl" value="https://YOUR-PROJECT-default-rtdb.firebaseio.com" />
  <add key="Firebase.ApiKey" value="YOUR_WEB_API_KEY" />
  <add key="Firebase.StorageBucket" value="YOUR-PROJECT.appspot.com" />
  <!-- Create and activate a Zoom Server-to-Server OAuth app with meeting:write:meeting:admin.
       HostEmail must be a Zoom user on that account who can schedule meetings.
       For participants to enter before the host, allow Join Before Host and do not lock Waiting Room on. -->
  <add key="Zoom.AccountId" value="YOUR_ZOOM_ACCOUNT_ID" />
  <add key="Zoom.ClientId" value="YOUR_ZOOM_CLIENT_ID" />
  <add key="Zoom.ClientSecret" value="YOUR_ZOOM_CLIENT_SECRET" />
  <add key="Zoom.HostEmail" value="host@example.com" />
  <!-- See docs/10-email-notifications.md. Use a verified sender and SMTP credentials. -->
  <add key="Notifications.Enabled" value="true" />
  <add key="Email.Enabled" value="false" />
  <add key="Email.ApplicationUrl" value="https://internships.example.edu/" />
  <add key="Email.FromAddress" value="YOUR_GMAIL_ADDRESS@gmail.com" />
  <add key="Email.FromName" value="University Internship Management System" />
  <add key="Email.SmtpHost" value="smtp.gmail.com" />
  <add key="Email.SmtpPort" value="587" />
  <add key="Email.EnableSsl" value="true" />
  <add key="Email.SmtpUsername" value="YOUR_GMAIL_ADDRESS@gmail.com" />
  <add key="Email.SmtpPassword" value="YOUR_GOOGLE_APP_PASSWORD" />
</appSettings>
