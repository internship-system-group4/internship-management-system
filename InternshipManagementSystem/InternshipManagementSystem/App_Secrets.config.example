<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to  App_Secrets.config  (same folder) and fill in the values.
  App_Secrets.config is git-ignored, so each team member keeps their own copy
  and nothing secret ever reaches GitHub.

  Where to find each value in the Firebase console:
    DatabaseUrl    Build > Realtime Database > the URL above the data tree
    ApiKey         Project settings > General > Web API Key
    StorageBucket  Build > Storage > the gs:// bucket name, without "gs://"
-->
<appSettings>
  <add key="Firebase.DatabaseUrl" value="https://YOUR-PROJECT-default-rtdb.firebaseio.com" />
  <add key="Firebase.ApiKey" value="YOUR_WEB_API_KEY" />
  <add key="Firebase.StorageBucket" value="YOUR-PROJECT.appspot.com" />
</appSettings>
