<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Academic.master.cs" Inherits="InternshipManagementSystem.Layout.AcademicMaster" %>

<!DOCTYPE html>
<html lang="en" class="academic-portal uims-portal">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%-- Page titles come from each page's Title attribute. --%>
    <title></title>
    <link rel="icon" href="~/Assets/images/favicon.png" runat="server" />
    <!-- Bootstrap 5 from CDN. If the demo room has no internet, download these
         two files into Assets/css and Assets/js and swap the four links. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Assets/css/site.css" runat="server" />
    <link rel="stylesheet" href="~/Assets/css/portal-layout.css" runat="server" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body class="academic-portal uims-portal">
<form id="mainForm" runat="server">
    <div class="uims-shell">
        <aside id="academicSidebar" data-portal-sidebar="true" class="uims-sidebar" aria-label="Academic navigation" tabindex="-1">
            <button type="button" class="student-nav-close" aria-label="Close navigation">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
            </button>
            <div class="uims-sidebar-brand">
                <img src="<%: ResolveUrl("~/Assets/images/gju-logo.png") %>" alt="German Jordanian University" width="88" height="65" />
                <div class="student-university"><span lang="ar" dir="rtl">الجامعة الألمانية الأردنية</span><span>German Jordanian University</span></div>
                <div><strong>Internship Management System</strong><small>Academic supervisor</small></div>
            </div>
            <nav>
                <ul class="uims-side-nav">
                    <li><a class="uims-side-link" href="<%: ResolveUrl("~/Pages/Academic/Dashboard.aspx") %>" <%= NavigationAttributes("~/Pages/Academic/Dashboard.aspx") %>><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>Dashboard</a></li>
                    <li><a class="uims-side-link" href="<%: ResolveUrl("~/Pages/Academic/StudentProgress.aspx") %>" <%= NavigationAttributes("~/Pages/Academic/StudentProgress.aspx") %>><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg>Student Progress</a></li>
                    <li><a class="uims-side-link" href="<%: ResolveUrl("~/Pages/Academic/FinalEvaluation.aspx") %>" <%= NavigationAttributes("~/Pages/Academic/FinalEvaluation.aspx") %>><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>Final Academic Evaluation</a></li>
                    <li><a class="uims-side-link" href="<%: ResolveUrl("~/Pages/Academic/Account.aspx") %>" <%= NavigationAttributes("~/Pages/Academic/Account.aspx") %>><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h8l4 4v14H6zM14 3v5h4M9 12h6M9 16h6"/></svg>My Account</a></li>
                    <li><a class="uims-side-link" href="<%: ResolveUrl("~/Pages/Meetings/MyMeetings.aspx") %>" <%= NavigationAttributes("~/Pages/Meetings/MyMeetings.aspx") %>><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 3h6v4H9zM9 12l2 2 4-4M9 18h6"/></svg>Meetings</a></li>
                </ul>
            </nav>
            <div class="student-logout">
                <asp:LinkButton ID="btnSignOut" runat="server" OnClick="btnSignOut_Click" CausesValidation="false">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4H4v16h5M13 8l4 4-4 4M8 12h13"/></svg><span>Log out</span>
                </asp:LinkButton>
            </div>
        </aside>

        <button type="button" class="student-nav-backdrop" aria-label="Close navigation backdrop" tabindex="-1" hidden></button>
        <div class="uims-content">
            <header class="uims-topbar">
                <button type="button" class="student-nav-toggle" aria-controls="academicSidebar" aria-expanded="false" aria-label="Open navigation">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                </button>
                <h1 class="uims-page-title" data-portal-label="Academic supervisor portal / "><%: Page.Title %></h1>
                <div class="uims-user">
                    <div class="uims-user-meta">
                        <asp:Literal ID="litUserName" runat="server" />
                        <small><asp:Literal ID="litRoleName" runat="server" /></small>
                    </div>
                    <span class="student-avatar" aria-hidden="true"><%: UserInitials %></span>
                </div>
            </header>

            <main class="uims-main-inner">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
        </div>
    </div>
</form>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="<%: ResolveUrl("~/Assets/js/portal-layout.js") %>"></script>
<asp:ContentPlaceHolder ID="scripts" runat="server" />
</body>
</html>
