<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Student.master.cs" Inherits="InternshipManagementSystem.Layout.StudentMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%-- Page titles come from each page's Title attribute. --%>
    <title></title>
    <link rel="icon" href="~/Assets/images/favicon.png" runat="server" />
    <!-- Bootstrap 5 from CDN. If the demo room has no internet, download these
         two files into Assets/css and Assets/js and swap the four links. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Assets/css/site.css" runat="server" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body>
<form id="mainForm" runat="server">
    <div class="uims-shell">
        <aside class="uims-sidebar">
            <div class="uims-sidebar-brand">
                <img src="<%: ResolveUrl("~/Assets/images/logo.png") %>" alt="" height="32" onerror="this.style.display='none'" />
                <div>
                    <strong>UIMS</strong>
                    <small>Student Portal</small>
                </div>
            </div>
            <nav>
                <ul class="uims-side-nav">
                    <li><a class="uims-side-link" href="<%: ResolveUrl("~/Pages/Student/Dashboard.aspx") %>">Dashboard</a></li>
                    <li><a class="uims-side-link" href="<%: ResolveUrl("~/Pages/Student/Profile.aspx") %>">My Profile</a></li>
                    <li><a class="uims-side-link" href="<%: ResolveUrl("~/Pages/Student/Opportunities.aspx") %>">Explore Opportunities</a></li>
                    <li><a class="uims-side-link" href="<%: ResolveUrl("~/Pages/Student/MyApplications.aspx") %>">My Applications</a></li>
                    <li><a class="uims-side-link" href="<%: ResolveUrl("~/Pages/Student/MyTasks.aspx") %>">My Tasks</a></li>
                    <li><a class="uims-side-link" href="<%: ResolveUrl("~/Pages/Student/Progress.aspx") %>">My Progress &amp; Evaluation</a></li>
                    <li><a class="uims-side-link" href="<%: ResolveUrl("~/Pages/Meetings/MyMeetings.aspx") %>">Meetings</a></li>
                </ul>
            </nav>
        </aside>

        <div class="uims-content">
            <header class="uims-topbar">
                <h1 class="uims-page-title"><%: Page.Title %></h1>
                <div class="uims-user">
                    <div class="uims-user-meta">
                        <asp:Literal ID="litUserName" runat="server" />
                        <small><asp:Literal ID="litRoleName" runat="server" /></small>
                    </div>
                    <asp:LinkButton ID="btnSignOut" runat="server" CssClass="btn btn-sm btn-outline-secondary"
                        OnClick="btnSignOut_Click" CausesValidation="false" Text="Sign out" />
                </div>
            </header>

            <main class="uims-main-inner">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
        </div>
    </div>
</form>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<asp:ContentPlaceHolder ID="scripts" runat="server" />
</body>
</html>
