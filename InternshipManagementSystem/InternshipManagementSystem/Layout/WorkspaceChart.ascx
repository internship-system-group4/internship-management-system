<%@ Control Language="C#" AutoEventWireup="true" CodeBehind="WorkspaceChart.ascx.cs" Inherits="InternshipManagementSystem.Layout.WorkspaceChart" %>
<% if(Model != null){ %>
<section class="ra-root" data-reference-analytics data-app-root="<%: ResolveUrl("~/") %>" aria-labelledby="<%: ClientID %>_heading">
 <script type="application/json" data-analytics-model><%= SafeJson %></script>
 <header class="ra-heading"><div><h3 id="<%: ClientID %>_heading"><%: Model.Title %></h3><p><%: Model.Scope %></p><p class="ra-range-caption" data-range-caption><%: L.T("Shared.WorkspaceChart.AvailableDatedRecordsCurrentCategoriesAre") %></p></div>
  <% if(Model.RangeMonths <= 0){ %><div class="ra-range" role="radiogroup" aria-label="<%: L.T("Shared.WorkspaceChart.ApprovalActivityRange") %>"><span class="ra-range-marker" aria-hidden="true"></span><button type="button" role="radio" aria-checked="true" data-range="6"><%: L.T("Shared.WorkspaceChart.6Months") %></button><button type="button" role="radio" aria-checked="false" tabindex="-1" data-range="12"><%: L.T("Shared.WorkspaceChart.12Months") %></button></div><% } %>
 </header>
 <div class="ra-kpis"><% for(int i=0;i<Model.Kpis.Count;i++){var kpi=Model.Kpis[i]; %>
  <button type="button" class="ra-kpi" data-kpi="<%: i %>" aria-haspopup="dialog"><span class="ra-kpi-label"><%: kpi.Label %></span><span class="ra-kpi-main"><strong data-kpi-value><%: kpi.Flow ? "—" : kpi.Value.ToString() %></strong><span class="ra-kpi-unit"><%: kpi.Unit %></span><span class="ra-spark" aria-hidden="true"></span></span><span class="ra-kpi-context"><%: kpi.Context %></span><span class="ra-kpi-comparison" data-kpi-comparison><%: kpi.Flow ? L.T("Shared.WorkspaceChart.DatedRecordsOnly") : L.T("Shared.WorkspaceChart.CurrentSnapshotLabel") %></span></button>
 <% } %></div>
 <div class="ra-primary">
  <figure class="ra-card ra-trend" data-chart-card="trend"><figcaption><div><h3><%: Model.TrendTitle %></h3><p data-trend-subtitle><%: L.T("Shared.WorkspaceChart.AvailableApprovalEventsByMonthUTC") %></p></div><a href="#<%: ClientID %>_trend_data" data-data-toggle="trend"><%: L.T("Shared.WorkspaceChart.ViewData") %></a></figcaption><div class="ra-legend"><span><i data-tone="approved"></i><%: Model.TrendUnit %></span></div><div class="ra-plot" data-plot="trend" role="img" aria-label="<%: Model.TrendTitle %>"><p role="status"><%: L.T("Shared.WorkspaceChart.PreparingDatedActivity") %></p></div><p class="ra-note" data-history-note></p><details id="<%: ClientID %>_trend_data" data-data-table="trend"><summary><%: L.T("Shared.WorkspaceChart.ActivityDataAndRecordDetails") %></summary><div class="ra-table-scroll ui-table-scroll"><table><caption><%: Model.TrendTitle %><%: L.T("Shared.WorkspaceChart.AvailableDatedRecordsOnly") %></caption><thead><tr><th scope="col"><%: L.T("Shared.WorkspaceChart.Month") %></th><th scope="col"><%: Model.TrendUnit %></th><th scope="col"><%: L.T("Shared.WorkspaceChart.Details") %></th></tr></thead><tbody data-trend-rows></tbody></table></div></details></figure>
  <figure class="ra-card ra-bar<%: Horizontal ? " ra-bar-horizontal" : "" %>" data-chart-card="bar"><figcaption><div><h3><%: Model.BarTitle %></h3><p><%: Model.BarContext %></p></div><a href="#<%: ClientID %>_bar_data" data-data-toggle="bar"><%: L.T("Shared.WorkspaceChart.ViewData") %></a></figcaption><% if(!string.IsNullOrEmpty(Model.BarNotice)){ %><p class="ra-notice" role="note"><span class="ra-notice-icon" aria-hidden="true">!</span><span><%: Model.BarNotice %></span></p><% } %><div class="ra-legend" data-bar-legend<%: Horizontal ? " hidden" : "" %>></div><div class="ra-plot" data-plot="bar" role="img" aria-label="<%: Model.BarTitle %>"><p role="status"><%: L.T("Shared.WorkspaceChart.PreparingCurrentCategories") %></p></div><details id="<%: ClientID %>_bar_data" data-data-table="bar"><summary><%: Model.BarDataTitle ?? L.T("Shared.WorkspaceChart.CategoryDataAndRecordDetails") %></summary><div class="ra-table-scroll ui-table-scroll"><table><caption><%: Model.BarTitle %><%: L.T("Shared.WorkspaceChart.CurrentSnapshotIn") %> <%: Model.BarUnit %></caption><thead><tr><th scope="col"><%: L.T("Shared.WorkspaceChart.Category") %></th><th scope="col"><%: Model.BarUnit %></th><% if(Horizontal){ %><th scope="col"><%: L.T("Shared.WorkspaceChart.Share") %></th><% } %><th scope="col"><%: L.T("Shared.WorkspaceChart.Details") %></th></tr></thead><tbody><% for(int i=0;i<Model.Bars.Count;i++){var point=Model.Bars[i]; %><tr><th scope="row"><%: point.Label %></th><td><%: point.Value %></td><% if(Horizontal){ %><td><%: Share(point.Value) %></td><% } %><td><button type="button" class="ra-table-action" data-records="bar" data-category="<%: i %>" aria-haspopup="dialog"><%: L.T("Shared.WorkspaceChart.ViewRecords") %><span class="visually-hidden">: <%: point.Label %></span></button><% if(!string.IsNullOrEmpty(point.Url)){ %> <a class="ra-table-action" href="<%: ResolveUrl(point.Url) %>"><%: L.T("Shared.WorkspaceChart.OpenStudentList") %><span class="visually-hidden">: <%: point.Label %></span></a><% } %></td></tr><% } %></tbody></table></div></details></figure>
 </div>
 <% if(Model.Breakdown != null && Model.Breakdown.Count > 0){ %><figure class="ra-card ra-breakdown" data-chart-card="donut"><figcaption><div><h3><%: Model.DonutTitle %></h3><p><%: L.T("Shared.WorkspaceChart.CurrentSnapshotMutuallyExclusiveCategories") %></p></div><a href="#<%: ClientID %>_donut_data" data-data-toggle="donut"><%: L.T("Shared.WorkspaceChart.ViewData") %></a></figcaption><div class="ra-breakdown-body"><div class="ra-donut" data-plot="donut" role="img" aria-label="<%: Model.DonutTitle %>"><p role="status"><%: L.T("Shared.WorkspaceChart.PreparingBreakdown") %></p></div><ul class="ra-breakdown-list"><% for(int i=0;i<Model.Breakdown.Count;i++){var slice=Model.Breakdown[i]; %><li><button type="button" data-records="donut" data-category="<%: i %>" aria-haspopup="dialog"><span><i data-tone="<%: slice.Tone %>"></i><%: slice.Label %></span><strong><%: slice.Value %></strong><span data-share="<%: i %>"></span></button></li><% } %></ul><p class="ra-breakdown-context"><%: L.T("Shared.WorkspaceChart.SelectACategoryToInspectIts") %></p></div><details id="<%: ClientID %>_donut_data" data-data-table="donut"><summary><%: L.T("Shared.WorkspaceChart.BreakdownData") %></summary><div class="ra-table-scroll ui-table-scroll"><table><caption><%: Model.DonutTitle %><%: L.T("Shared.WorkspaceChart.CurrentSnapshot") %></caption><thead><tr><th scope="col"><%: L.T("Shared.WorkspaceChart.Category") %></th><th scope="col"><%: Model.DonutUnit %></th></tr></thead><tbody><% foreach(var slice in Model.Breakdown){ %><tr><th scope="row"><%: slice.Label %></th><td><%: slice.Value %></td></tr><% } %></tbody></table></div></details></figure><% } %>
 <div class="ra-tooltip" role="status" hidden></div><noscript><p><%: L.T("Shared.WorkspaceChart.JavaScriptEnablesChartsRangeFilteringAnd") %></p></noscript>
 <div class="modal fade ra-record-modal" id="<%: ClientID %>_records" tabindex="-1" aria-labelledby="<%: ClientID %>_records_title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div><h3 class="modal-title" tabindex="-1" id="<%: ClientID %>_records_title"></h3><p data-record-scope></p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%: L.T("Shared.WorkspaceChart.CloseDetails") %>"></button></div><div class="modal-body"><ol class="ra-record-list"></ol><p data-record-empty hidden><%: L.T("Shared.WorkspaceChart.NoMatchingRecordsInThisScope") %></p></div><div class="modal-footer"><div class="ra-record-pagination"><button type="button" class="btn btn-outline-primary" data-record-page="-1"><%: L.T("Shared.WorkspaceChart.Previous") %></button><span data-record-page-label></span><button type="button" class="btn btn-outline-primary" data-record-page="1"><%: L.T("Shared.WorkspaceChart.Next") %></button></div><button type="button" class="btn btn-brand" data-bs-dismiss="modal"><%: L.T("Shared.WorkspaceChart.Done") %></button></div></div></div></div>
</section>
<% } %>
