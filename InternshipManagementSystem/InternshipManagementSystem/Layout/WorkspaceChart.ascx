<%@ Control Language="C#" AutoEventWireup="true" CodeBehind="WorkspaceChart.ascx.cs" Inherits="InternshipManagementSystem.Layout.WorkspaceChart" %>
<% if(Model != null){ %>
<section class="ra-root" data-reference-analytics data-app-root="<%: ResolveUrl("~/") %>" aria-labelledby="<%: ClientID %>_heading">
 <script type="application/json" data-analytics-model><%= SafeJson %></script>
 <header class="ra-heading"><div><h3 id="<%: ClientID %>_heading"><%: Model.Title %></h3><p><%: Model.Scope %></p><p class="ra-range-caption" data-range-caption>Available dated records; current categories are a snapshot.</p></div>
  <div class="ra-range" role="radiogroup" aria-label="Approval activity range"><span class="ra-range-marker" aria-hidden="true"></span><button type="button" role="radio" aria-checked="true" data-range="6">6 months</button><button type="button" role="radio" aria-checked="false" tabindex="-1" data-range="12">12 months</button></div>
 </header>
 <div class="ra-kpis"><% for(int i=0;i<Model.Kpis.Count;i++){var kpi=Model.Kpis[i]; %>
  <button type="button" class="ra-kpi" data-kpi="<%: i %>" aria-haspopup="dialog"><span class="ra-kpi-label"><%: kpi.Label %></span><span class="ra-kpi-main"><strong data-kpi-value><%: kpi.Flow ? "—" : kpi.Value.ToString() %></strong><span class="ra-kpi-unit"><%: kpi.Unit %></span><span class="ra-spark" aria-hidden="true"></span></span><span class="ra-kpi-context"><%: kpi.Context %></span><span class="ra-kpi-comparison" data-kpi-comparison><%: kpi.Flow ? "Dated records only" : "Current snapshot" %></span></button>
 <% } %></div>
 <div class="ra-primary">
  <figure class="ra-card ra-trend" data-chart-card="trend"><figcaption><div><h3><%: Model.TrendTitle %></h3><p data-trend-subtitle>Available approval events by month, UTC</p></div><a href="#<%: ClientID %>_trend_data" data-data-toggle="trend">View data</a></figcaption><div class="ra-legend"><span><i data-tone="approved"></i><%: Model.TrendUnit %></span></div><div class="ra-plot" data-plot="trend" role="img" aria-label="<%: Model.TrendTitle %>"><p role="status">Preparing dated activity…</p></div><p class="ra-note" data-history-note></p><details id="<%: ClientID %>_trend_data" data-data-table="trend"><summary>Activity data and record details</summary><div class="ra-table-scroll ui-table-scroll"><table><caption><%: Model.TrendTitle %>, available dated records only</caption><thead><tr><th scope="col">Month</th><th scope="col"><%: Model.TrendUnit %></th><th scope="col">Details</th></tr></thead><tbody data-trend-rows></tbody></table></div></details></figure>
  <figure class="ra-card ra-bar" data-chart-card="bar"><figcaption><div><h3><%: Model.BarTitle %></h3><p><%: Model.BarContext %></p></div><a href="#<%: ClientID %>_bar_data" data-data-toggle="bar">View data</a></figcaption><div class="ra-legend" data-bar-legend></div><div class="ra-plot" data-plot="bar" role="img" aria-label="<%: Model.BarTitle %>"><p role="status">Preparing current categories…</p></div><details id="<%: ClientID %>_bar_data" data-data-table="bar"><summary>Category data and record details</summary><div class="ra-table-scroll ui-table-scroll"><table><caption><%: Model.BarTitle %>, current snapshot in <%: Model.BarUnit %></caption><thead><tr><th scope="col">Category</th><th scope="col"><%: Model.BarUnit %></th><th scope="col">Details</th></tr></thead><tbody><% for(int i=0;i<Model.Bars.Count;i++){var point=Model.Bars[i]; %><tr><th scope="row"><%: point.Label %></th><td><%: point.Value %></td><td><button type="button" class="ra-table-action" data-records="bar" data-category="<%: i %>" aria-haspopup="dialog">View records<span class="visually-hidden">: <%: point.Label %></span></button></td></tr><% } %></tbody></table></div></details></figure>
 </div>
 <figure class="ra-card ra-breakdown" data-chart-card="donut"><figcaption><div><h3><%: Model.DonutTitle %></h3><p>Current snapshot · mutually exclusive categories</p></div><a href="#<%: ClientID %>_donut_data" data-data-toggle="donut">View data</a></figcaption><div class="ra-breakdown-body"><div class="ra-donut" data-plot="donut" role="img" aria-label="<%: Model.DonutTitle %>"><p role="status">Preparing breakdown…</p></div><ul class="ra-breakdown-list"><% for(int i=0;i<Model.Breakdown.Count;i++){var slice=Model.Breakdown[i]; %><li><button type="button" data-records="donut" data-category="<%: i %>" aria-haspopup="dialog"><span><i data-tone="<%: slice.Tone %>"></i><%: slice.Label %></span><strong><%: slice.Value %></strong><span data-share="<%: i %>"></span></button></li><% } %></ul><p class="ra-breakdown-context">Select a category to inspect its underlying authorized records. The range selector changes dated activity only; this breakdown shows current records.</p></div><details id="<%: ClientID %>_donut_data" data-data-table="donut"><summary>Breakdown data</summary><div class="ra-table-scroll ui-table-scroll"><table><caption><%: Model.DonutTitle %>, current snapshot</caption><thead><tr><th scope="col">Category</th><th scope="col"><%: Model.DonutUnit %></th></tr></thead><tbody><% foreach(var slice in Model.Breakdown){ %><tr><th scope="row"><%: slice.Label %></th><td><%: slice.Value %></td></tr><% } %></tbody></table></div></details></figure>
 <div class="ra-tooltip" role="status" hidden></div><noscript><p>JavaScript enables charts, range filtering and drill-down. Current values and data tables above remain available.</p></noscript>
 <div class="modal fade ra-record-modal" id="<%: ClientID %>_records" tabindex="-1" aria-labelledby="<%: ClientID %>_records_title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div><h3 class="modal-title" tabindex="-1" id="<%: ClientID %>_records_title"></h3><p data-record-scope></p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close details"></button></div><div class="modal-body"><ol class="ra-record-list"></ol><p data-record-empty hidden>No matching records in this scope.</p></div><div class="modal-footer"><div class="ra-record-pagination"><button type="button" class="btn btn-outline-primary" data-record-page="-1">Previous</button><span data-record-page-label></span><button type="button" class="btn btn-outline-primary" data-record-page="1">Next</button></div><button type="button" class="btn btn-brand" data-bs-dismiss="modal">Done</button></div></div></div></div>
</section>
<% } %>
