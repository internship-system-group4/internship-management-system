<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Company.master.cs" Inherits="InternshipManagementSystem.Layout.CompanyMaster" %>
<%@ Register Src="~/Layout/ThemeSelector.ascx" TagPrefix="uims" TagName="ThemeSelector" %>
<%@ Register Src="~/Layout/Sidebar.ascx" TagPrefix="uims" TagName="Sidebar" %>
<%@ Register Src="~/Layout/NotificationBell.ascx" TagPrefix="uims" TagName="NotificationBell" %>

<!DOCTYPE html>
<html lang="en" class="company-portal uims-portal">
<head runat="server">
    <meta charset="utf-8" />
    <%-- Theme: applied before the first paint. Missing or invalid preference -> Light (see Assets/js/theme.js). --%>
    <script>(function(r){var p='light';try{var s=localStorage.getItem('uims-theme');if(s==='dark'||s==='system')p=s;}catch(e){}var t=p==='dark'||(p==='system'&&window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches)?'dark':'light';r.setAttribute('data-theme-preference',p);r.setAttribute('data-theme',t);r.setAttribute('data-bs-theme',t);r.style.colorScheme=t;}(document.documentElement));</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%-- Page titles come from each page's Title attribute. --%>
    <title></title>
    <link rel="icon" href="~/Assets/images/gju-logo.png" runat="server" />
    <!-- Bootstrap 5 from CDN. If the demo room has no internet, download these
         two files into Assets/css and Assets/js and swap the four links. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Assets/css/site.css" runat="server" />
    <link rel="stylesheet" href="~/Assets/css/portal-layout.css?v=20261023-4" runat="server" />
    <link rel="stylesheet" href="~/Assets/css/notifications.css?v=20261022-notify-1" runat="server" />
    <link rel="stylesheet" href="~/Assets/css/ui-tokens.css?v=20261023-4" runat="server" />
    <link rel="stylesheet" href="~/Assets/css/theme.css?v=20261023-2" runat="server" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
<link rel="stylesheet" href="~/Assets/css/ui-system.css?v=20261023-4" runat="server" />
<link rel="stylesheet" href="~/Assets/css/workspace.css?v=20261023-4" runat="server" />
<link rel="stylesheet" href="~/Assets/css/interface.css?v=20261023-4" runat="server" />
<link rel="stylesheet" href="~/Assets/css/reference-analytics.css?v=20261023-5" runat="server" />
</head>
<body data-ui-owner="<%: InternshipManagementSystem.Security.SessionHelper.Current == null ? "" : InternshipManagementSystem.Security.SessionHelper.Current.Id %>" class="company-portal uims-portal">
<form id="mainForm" runat="server">
    <div class="uims-shell">
        <aside id="companySidebar" data-portal-sidebar="true" class="uims-sidebar" aria-label="Company navigation" tabindex="-1">
            <uims:Sidebar ID="PortalSidebar" runat="server" />
            <div class="student-logout">
                <asp:LinkButton ID="btnSignOut" runat="server" OnClick="btnSignOut_Click" CausesValidation="false" CssClass="uims-sidebar-signout" ToolTip="Log out">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4H4v16h5M13 8l4 4-4 4M8 12h13"/></svg><span class="uims-sidebar-label">Log out</span>
                </asp:LinkButton>
            </div>
        </aside>

        <button type="button" class="student-nav-backdrop" aria-label="Close navigation backdrop" tabindex="-1" hidden></button>
        <div class="uims-content">
            <header class="uims-topbar">
                <button type="button" class="student-nav-toggle" aria-controls="companySidebar" aria-expanded="false" aria-label="Open navigation">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                </button>
                <h1 class="uims-page-title" data-portal-label="Company portal / "><%: Page.Title %></h1>
                <div class="uims-user">
                    <uims:ThemeSelector runat="server" Variant="menu" />
                    <uims:NotificationBell runat="server" />
                    <div class="uims-user-meta">
                        <asp:Literal ID="litUserName" runat="server" />
                        <small><asp:Literal ID="litRoleName" runat="server" /></small>
                    </div>
                    <span class="student-avatar" aria-hidden="true"><%: UserInitials %></span>
                </div>
            </header>

            <main class="uims-main-inner">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
        </div>
    </div>
</form>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="<%: ResolveUrl("~/Assets/js/theme.js?v=20261023-1") %>"></script>
<script src="<%: ResolveUrl("~/Assets/js/portal-layout.js?v=20261023-4") %>"></script>
<asp:ContentPlaceHolder ID="scripts" runat="server" />
<script src="<%: ResolveUrl("~/Assets/js/ui-system.js?v=20261023-4") %>"></script>
<script src="<%: ResolveUrl("~/Assets/js/workspace.js?v=20261023-4") %>"></script>
<script src="<%: ResolveUrl("~/Assets/js/workspace-charts.js?v=20261023-5") %>"></script>
</body>
</html>
