<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Coordinator.master.cs" Inherits="InternshipManagementSystem.Layout.CoordinatorMaster" %>
<%@ Register TagPrefix="uims" Namespace="InternshipManagementSystem.Layout" Assembly="InternshipManagementSystem" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title></title>
    <link rel="icon" href="~/Assets/images/favicon.png" runat="server" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Assets/css/site.css" runat="server" />
    <link rel="stylesheet" href="~/Assets/css/notifications.css" runat="server" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body class="<%: UseDashboardTheme ? "uims-theme" : "" %>">
<form id="mainForm" runat="server">
    <% if (UseDashboardTheme) { %>
    <a href="#workspace-content" class="theme-skip-link">Skip to content</a>
    <% } %>
    <svg width="0" height="0" style="position:absolute;overflow:hidden" aria-hidden="true" focusable="false">
        <defs>
            <symbol id="icon-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></symbol>
            <symbol id="icon-users" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m20 0v-2a4 4 0 0 0-3-3.87M15 3.13a4 4 0 0 1 0 7.75"/><circle cx="9" cy="7" r="4"/></symbol>
            <symbol id="icon-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
            <symbol id="icon-building" viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M9 21v-4h6v4M8 7h1m6 0h1m-8 4h1m6 0h1"/></symbol>
            <symbol id="icon-cap" viewBox="0 0 24 24"><path d="m2 9 10-5 10 5-10 5L2 9Zm4 2v6c4 3 8 3 12 0v-6m4-2v7"/></symbol>
            <symbol id="icon-briefcase" viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V4h8v3M3 12c6 4 12 4 18 0m-9 0v4"/></symbol>
            <symbol id="icon-check" viewBox="0 0 24 24"><path d="m8 12 3 3 5-6"/><rect x="4" y="3" width="16" height="18" rx="2"/></symbol>
            <symbol id="icon-chart" viewBox="0 0 24 24"><path d="M4 3v17h17M9 16v-4m5 4V8m5 8V4"/></symbol>
            <symbol id="icon-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></symbol>
            <symbol id="icon-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 11h18m-12 4h1m4 0h1"/></symbol>
            <symbol id="icon-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></symbol>
            <symbol id="icon-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5"/></symbol>
            <symbol id="icon-shield" viewBox="0 0 24 24"><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/></symbol>
        </defs>
    </svg>
    <div class="uims-shell">
        <aside class="uims-sidebar">
            <div class="uims-sidebar-brand">
                <% if (UseDashboardTheme) { %>
                <span class="brand-mark"><svg class="theme-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><use href="#icon-cap" /></svg></span>
                <% } else { %>
                <img src="<%: ResolveUrl("~/Assets/images/logo.png") %>" alt="" height="32" onerror="this.style.display='none'" />
                <% } %>
                <div><strong>UIMS</strong><small><%: UseDashboardTheme ? "Internship management" : "Coordinator" %></small></div>
            </div>
            <nav aria-label="Coordinator navigation">
                <% if (UseDashboardTheme) { %><p class="nav-section-label">Coordinator workspace</p><% } %>
                <ul class="uims-side-nav">
                    <li><a class="uims-side-link" aria-current="<%: CurrentPage("~/Pages/Coordinator/Dashboard.aspx") %>" href="<%: ResolveUrl("~/Pages/Coordinator/Dashboard.aspx") %>"><% if (UseDashboardTheme) { %><svg class="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><use href="#icon-grid" /></svg><% } %><span>Dashboard</span></a></li>
                    <li><a class="uims-side-link" aria-current="<%: CurrentPage("~/Pages/Coordinator/Students.aspx") %>" href="<%: ResolveUrl("~/Pages/Coordinator/Students.aspx") %>"><% if (UseDashboardTheme) { %><svg class="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><use href="#icon-users" /></svg><% } %><span>Student Records</span></a></li>
                    <li><a class="uims-side-link" aria-current="<%: CurrentPage("~/Pages/Coordinator/AddStudent.aspx") %>" href="<%: ResolveUrl("~/Pages/Coordinator/AddStudent.aspx") %>"><% if (UseDashboardTheme) { %><svg class="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><use href="#icon-plus" /></svg><% } %><span>Add Student</span></a></li>
                    <li><a class="uims-side-link" aria-current="<%: CurrentPage("~/Pages/Coordinator/ManageStudents.aspx") %>" href="<%: ResolveUrl("~/Pages/Coordinator/ManageStudents.aspx") %>"><% if (UseDashboardTheme) { %><svg class="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><use href="#icon-users" /></svg><% } %><span>Manage Students</span></a></li>
                    <li><a class="uims-side-link" aria-current="<%: CurrentPage("~/Pages/Coordinator/Companies.aspx") %>" href="<%: ResolveUrl("~/Pages/Coordinator/Companies.aspx") %>"><% if (UseDashboardTheme) { %><svg class="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><use href="#icon-building" /></svg><% } %><span>Manage Companies</span></a></li>
                    <li><a class="uims-side-link" aria-current="<%: CurrentPage("~/Pages/Coordinator/AcademicSupervisors.aspx") %>" href="<%: ResolveUrl("~/Pages/Coordinator/AcademicSupervisors.aspx") %>"><% if (UseDashboardTheme) { %><svg class="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><use href="#icon-cap" /></svg><% } %><span>Academic Supervisors</span></a></li>
                    <li><a class="uims-side-link" aria-current="<%: CurrentPage("~/Pages/Coordinator/Groups.aspx") %>" href="<%: ResolveUrl("~/Pages/Coordinator/Groups.aspx") %>"><% if (UseDashboardTheme) { %><svg class="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><use href="#icon-users" /></svg><% } %><span>Groups &amp; Assignments</span></a></li>
                    <li><a class="uims-side-link" aria-current="<%: CurrentPage("~/Pages/Coordinator/Placements.aspx") %>" href="<%: ResolveUrl("~/Pages/Coordinator/Placements.aspx") %>"><% if (UseDashboardTheme) { %><svg class="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><use href="#icon-briefcase" /></svg><% } %><span>Placements &amp; Progress</span></a></li>
                    <li><a class="uims-side-link" aria-current="<%: CurrentPage("~/Pages/Coordinator/CompletionReview.aspx") %>" href="<%: ResolveUrl("~/Pages/Coordinator/CompletionReview.aspx") %>"><% if (UseDashboardTheme) { %><svg class="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><use href="#icon-check" /></svg><% } %><span>Final Completion Review</span></a></li>
                    <li><a class="uims-side-link" aria-current="<%: CurrentPage("~/Pages/Reports/Grades.aspx") %>" href="<%: ResolveUrl("~/Pages/Reports/Grades.aspx") %>"><% if (UseDashboardTheme) { %><svg class="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><use href="#icon-chart" /></svg><% } %><span>Grades &amp; Results</span></a></li>
                    <li><a class="uims-side-link" aria-current="<%: CurrentPage("~/Pages/Coordinator/ContactMessages.aspx") %>" href="<%: ResolveUrl("~/Pages/Coordinator/ContactMessages.aspx") %>"><% if (UseDashboardTheme) { %><svg class="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><use href="#icon-mail" /></svg><% } %><span>Contact Messages</span></a></li>
                    <li><a class="uims-side-link" aria-current="<%: CurrentPage("~/Pages/Meetings/MyMeetings.aspx") %>" href="<%: ResolveUrl("~/Pages/Meetings/MyMeetings.aspx") %>"><% if (UseDashboardTheme) { %><svg class="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><use href="#icon-calendar" /></svg><% } %><span>Meetings</span></a></li>
                    <li><a class="uims-side-link" aria-current="<%: CurrentPage("~/Pages/Coordinator/Account.aspx") %>" href="<%: ResolveUrl("~/Pages/Coordinator/Account.aspx") %>"><% if (UseDashboardTheme) { %><svg class="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><use href="#icon-user" /></svg><% } %><span>My Account</span></a></li>
                </ul>
            </nav>
            <% if (UseDashboardTheme) { %><div class="sidebar-note"><strong>A little guidance. A big future<span>.</span></strong>Connecting learning with opportunity.</div><% } %>
        </aside>
        <div class="uims-content">
            <header class="uims-topbar">
                <h1 class="uims-page-title"><%: Page.Title %></h1>
                <div class="uims-user">
                    <uims:NotificationBell ID="NotificationMenu" runat="server" />
                    <% if (UseDashboardTheme) { %><span class="user-avatar"><svg class="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><use href="#icon-user" /></svg></span><% } %>
                    <div class="uims-user-meta">
                        <asp:Literal ID="litUserName" runat="server" />
                        <small><asp:Literal ID="litRoleName" runat="server" /></small>
                    </div>
                    <asp:LinkButton ID="btnSignOut" runat="server" CssClass="btn btn-sm btn-outline-secondary" OnClick="btnSignOut_Click" CausesValidation="false" Text="Sign out" />
                </div>
            </header>
            <main id="workspace-content" class="uims-main-inner" tabindex="-1">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
        </div>
    </div>
</form>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="<%: ResolveUrl("~/Assets/js/notifications.js") %>"></script>
<asp:ContentPlaceHolder ID="scripts" runat="server" />
</body>
</html>
