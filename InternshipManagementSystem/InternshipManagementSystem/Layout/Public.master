<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Public.master.cs" Inherits="InternshipManagementSystem.Layout.PublicMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%-- Page titles come from each page's Title attribute. --%>
    <title></title>
    <link rel="icon" href="~/Assets/images/favicon.png" runat="server" />
    <!-- Bootstrap 5 from CDN. If the demo room has no internet, download these
         two files into Assets/css and Assets/js and swap the four links. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Assets/css/site.css" runat="server" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body>
<form id="mainForm" runat="server">
    <nav class="navbar navbar-expand-lg uims-navbar">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="<%: ResolveUrl("~/Default.aspx") %>">
                <img src="<%: ResolveUrl("~/Assets/images/logo.png") %>" alt="" height="36" onerror="this.style.display='none'" />
                <span>UIMS</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="publicNav">
                <ul class="navbar-nav gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="<%: ResolveUrl("~/Default.aspx") %>">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="<%: ResolveUrl("~/Pages/Public/About.aspx") %>">About Us</a></li>
                    <li class="nav-item"><a class="nav-link" href="<%: ResolveUrl("~/Pages/Public/Contact.aspx") %>">Contact Us</a></li>
                    <li class="nav-item"><a class="btn btn-brand ms-lg-2" href="<%: ResolveUrl("~/Pages/Account/Login.aspx") %>">Login</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="uims-main">
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>

    <footer class="uims-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span><%: InternshipManagementSystem.Common.Constants.UniversityName %></span>
            <span>University Internship Management System &middot; Group 4</span>
        </div>
    </footer>
</form>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<asp:ContentPlaceHolder ID="scripts" runat="server" />
</body>
</html>
