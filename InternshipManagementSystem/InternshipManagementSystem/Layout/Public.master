<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Public.master.cs" Inherits="InternshipManagementSystem.Layout.PublicMaster" %>
<!DOCTYPE html>
<html lang="en" class="uims-public">
<head runat="server">
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title></title>
    <link rel="icon" href="~/Assets/images/gju-logo.png" runat="server" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Assets/css/site.css" runat="server" />
    <link rel="stylesheet" href="~/Assets/css/public-layout.css?v=20261021-4" runat="server" />
    <link rel="stylesheet" href="~/Assets/css/ui-tokens.css?v=20261023-4" runat="server" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
    <link rel="stylesheet" href="~/Assets/css/public-navbar.css?v=20261022-2" runat="server" />
    <link rel="stylesheet" href="~/Assets/css/public-footer.css?v=20261022-10" runat="server" />
<link rel="stylesheet" href="~/Assets/css/ui-system.css?v=20261023-4" runat="server" />
<link rel="stylesheet" href="~/Assets/css/workspace.css?v=20261023-4" runat="server" />
<link rel="stylesheet" href="~/Assets/css/interface.css?v=20261023-4" runat="server" />
</head>
<body class="uims-public">
<form id="mainForm" runat="server">
    <a class="public-skip" href="#public-content">Skip to content</a>
    <header class="public-header uims-public-nav" data-public-navbar>
        <div class="public-container public-header-inner">
            <a class="public-brand" href="<%: ResolveUrl("~/Default.aspx") %>" aria-label="UIMS home">
                <img src="<%: ResolveUrl("~/Assets/images/gju-logo.png") %>" alt="German Jordanian University" width="64" height="48" />
                <span><strong>UIMS</strong><small>German Jordanian University</small></span>
            </a>
            <nav class="public-navigation" aria-label="Main navigation">
                <button class="public-menu-toggle" type="button" aria-controls="publicNav" aria-expanded="false" aria-label="Open main menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg></button>
                <div class="public-links" id="publicNav">
                    <span class="uims-public-nav-highlight" aria-hidden="true"></span>
                    <a href="<%: ResolveUrl("~/Default.aspx") %>" <%= NavigationAttributes("~/Default.aspx") %>>Home</a>
                    <a href="<%: ResolveUrl("~/Pages/Public/About.aspx") %>" <%= NavigationAttributes("~/Pages/Public/About.aspx") %>>About us</a>
                    <a href="<%: ResolveUrl("~/Default.aspx") %>#opportunities">Opportunities</a>
                    <a href="<%: ResolveUrl("~/Default.aspx") %>#how-it-works">How it works</a>
                    <a href="<%: ResolveUrl("~/Pages/Public/Contact.aspx") %>" <%= NavigationAttributes("~/Pages/Public/Contact.aspx") %>>Contact us</a>
                    <a class="public-login" href="<%: PortalActionUrl %>" <%= NavigationAttributes(Constants.Routes.Login) %>><%: PortalActionText %></a>
                </div>
            </nav>
        </div>
    </header>
    <main id="public-content" class="uims-main public-container" tabindex="-1"><asp:ContentPlaceHolder ID="MainContent" runat="server" /></main>
    <footer class="uims-public-footer" data-public-footer>
        <%-- Decorative layered waves; each path repeats every 1440 units so a -50% loop is seamless. --%>
        <div class="uims-public-footer-waves" aria-hidden="true">
            <svg class="uims-public-footer-wave is-back" viewBox="0 0 2880 160" preserveAspectRatio="none" focusable="false"><path d="M0 52 C180 18 540 18 720 52 C900 86 1260 86 1440 52 C1620 18 1980 18 2160 52 C2340 86 2700 86 2880 52 V160 H0 Z" /></svg>
            <svg class="uims-public-footer-wave is-middle" viewBox="0 0 2880 160" preserveAspectRatio="none" focusable="false"><path d="M0 80 C180 52 540 52 720 80 C900 108 1260 108 1440 80 C1620 52 1980 52 2160 80 C2340 108 2700 108 2880 80 V160 H0 Z" /></svg>
            <svg class="uims-public-footer-wave is-front" viewBox="0 0 2880 160" preserveAspectRatio="none" focusable="false"><path d="M0 108 C180 86 540 86 720 108 C900 130 1260 130 1440 108 C1620 86 1980 86 2160 108 C2340 130 2700 130 2880 108 V160 H0 Z" /></svg>
        </div>
        <div class="uims-public-footer-body">
            <div class="public-container uims-public-footer-main">
                <div class="uims-public-footer-grid">
                    <section class="uims-public-footer-identity" aria-labelledby="footerIdentityTitle">
                        <a class="uims-public-footer-logo" href="<%: ResolveUrl("~/Default.aspx") %>" aria-label="UIMS home"><img src="<%: ResolveUrl("~/Assets/images/gju-logo.png") %>" alt="" width="64" height="48" /></a>
                        <h2 id="footerIdentityTitle">Internship Management System</h2>
                        <p>Connecting students, university supervisors and companies throughout the internship journey at German Jordanian University.</p>
                    </section>
                    <nav aria-labelledby="footerLinksTitle">
                        <h2 id="footerLinksTitle">Quick links</h2>
                        <ul>
                            <li><a href="<%: ResolveUrl("~/Default.aspx") %>">Home</a></li>
                            <li><a href="<%: ResolveUrl("~/Pages/Public/About.aspx") %>">About us</a></li>
                            <li><a href="<%: ResolveUrl("~/Default.aspx") %>#opportunities">Opportunities</a></li>
                            <li><a href="<%: ResolveUrl("~/Default.aspx") %>#how-it-works">How it works</a></li>
                            <li><a href="<%: ResolveUrl("~/Pages/Public/Contact.aspx") %>">Contact us</a></li>
                            <li><a href="<%: PortalActionUrl %>"><%: PortalActionText %></a></li>
                        </ul>
                    </nav>
                    <section aria-labelledby="footerContactTitle">
                        <h2 id="footerContactTitle">Contact</h2>
                        <address>
                            <p>For account access and internship guidance, contact your university coordinator.</p>
                            <a href="<%: ResolveUrl("~/Pages/Public/Contact.aspx") %>">Message the coordination team</a>
                        </address>
                    </section>
                    <section aria-labelledby="footerOfficialTitle">
                        <h2 id="footerOfficialTitle">Official links</h2>
                        <ul>
                            <li><a class="uims-public-footer-official" href="<%: Constants.UniversityWebsite %>" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" /></svg><span>GJU official website<span class="visually-hidden"> (opens in a new tab)</span></span></a></li>
                        </ul>
                    </section>
                </div>
                <%-- Campus map: a MapLibre flight to the verified main campus (public-footer-map.js). The Google embed is the
                     no-script view and the fallback when WebGL or the map cannot load; the address and links always remain. --%>
                <section class="uims-public-footer-campus" aria-labelledby="footerLocationTitle" data-footer-map
                    data-runtime="<%: ResolveUrl("~/Assets/js/vendor/maplibre/maplibre-gl.mjs") %>" data-stylesheet="<%: ResolveUrl("~/Assets/js/vendor/maplibre/maplibre-gl.css") %>" data-lat="<%: Constants.CampusLatitude %>" data-lng="<%: Constants.CampusLongitude %>">
                    <h2 id="footerLocationTitle">University Location</h2>
                    <address><p>Amman Madaba Street, Amman, Jordan</p></address>
                    <div class="uims-public-footer-campus-map" data-footer-map-stage>
                        <div class="uims-public-footer-campus-canvas" data-footer-map-canvas></div>
                        <iframe class="uims-public-footer-campus-embed" data-footer-map-embed src="<%: Constants.UniversityMapEmbedUrl %>" title="Map of the German Jordanian University main campus, Amman Madaba Street, Jordan" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                        <p class="uims-public-footer-campus-loading" data-footer-map-loading role="status" hidden>Loading map&hellip;</p>
                        <button type="button" class="uims-public-footer-campus-button" data-footer-map-explore hidden>Explore campus</button>
                        <button type="button" class="uims-public-footer-campus-button" data-footer-map-replay hidden>Replay flight</button>
                    </div>
                    <div class="uims-public-footer-campus-actions">
                        <a href="<%: Constants.UniversityDirectionsUrl %>" target="_blank" rel="noopener noreferrer" data-footer-map-directions><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.4" /></svg>Get directions<span class="visually-hidden"> (opens in a new tab)</span></a>
                        <a href="<%: Constants.UniversityMapUrl %>" target="_blank" rel="noopener noreferrer"><span class="visually-hidden">View on </span>Google Maps<span class="visually-hidden"> (opens in a new tab)</span></a>
                    </div>
                </section>
            </div>
            <div class="public-container uims-public-footer-bottom">
                <p>&copy; <%: DateTime.UtcNow.Year %> UIMS &middot; Group 4 &middot; Student project &middot; GJU-inspired visual theme</p>
                <div class="uims-public-footer-actions">
                    <button type="button" class="uims-public-footer-pause" data-footer-wave-pause aria-pressed="false" hidden>Pause waves</button>
                    <a class="uims-public-footer-powered" href="<%: ResolveUrl("~/Pages/Public/PoweredBy.aspx") %>" aria-label="Powered by &mdash; Meet the development team">Powered by</a>
                </div>
            </div>
        </div>
    </footer>
</form>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="<%: ResolveUrl("~/Assets/js/public-layout.js?v=20261022-5") %>"></script>
<script src="<%: ResolveUrl("~/Assets/js/public-navbar.js?v=20261022-2") %>"></script>
<script src="<%: ResolveUrl("~/Assets/js/public-footer.js?v=20261022-1") %>"></script>
<script src="<%: ResolveUrl("~/Assets/js/public-footer-map.js?v=20261022-5") %>"></script>
<asp:ContentPlaceHolder ID="scripts" runat="server" />
<script src="<%: ResolveUrl("~/Assets/js/ui-system.js?v=20261023-4") %>"></script>
<script src="<%: ResolveUrl("~/Assets/js/workspace.js?v=20261023-4") %>"></script>
</body>
</html>
