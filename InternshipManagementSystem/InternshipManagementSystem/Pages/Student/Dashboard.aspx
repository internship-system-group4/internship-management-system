<%@ Page CodePage="65001" Language="C#" MasterPageFile="~/Layout/Student.master" AutoEventWireup="true" CodeBehind="Dashboard.aspx.cs" Inherits="InternshipManagementSystem.Pages.StudentArea.Dashboard" Title="Student Dashboard" %>
<asp:Content ID="Head" ContentPlaceHolderID="head" runat="server"><link rel="stylesheet" href="<%: ResolveUrl("~/Assets/css/simple-workspace.css?v=20261024-1") %>" /></asp:Content>
<asp:Content ID="Body" ContentPlaceHolderID="MainContent" runat="server">
<div class="simple-workspace" data-simple-workspace>
<header class="sw-heading"><div><h1><span data-ui-icon="study" aria-hidden="true"></span><%: L.T("Student.Dashboard.StudentWorkspace") %></h1><p><asp:Literal ID="litStudentName" runat="server" /><%: L.T("Student.Dashboard.KeepYourNextStepInView") %></p></div><a class="btn btn-brand" href="Opportunities.aspx"><span data-ui-icon="search" aria-hidden="true"></span><%: L.T("Student.Dashboard.ExploreOpportunities") %></a></header>
<asp:Panel ID="pnlError" runat="server" Visible="false" CssClass="alert alert-danger" role="alert"><%: L.T("Student.Dashboard.WeCouldNotLoadYourInternship") %> <a href="Dashboard.aspx"><%: L.T("Student.Dashboard.RefreshToTryAgain") %></a>.</asp:Panel>
<div class="sw-search" data-workspace-search hidden>
 <label for="workspaceSearch" class="visually-hidden"><%: L.T("Student.Dashboard.SearchWorkspace") %></label>
 <div class="sw-search-field"><span data-ui-icon="search" aria-hidden="true"></span><input id="workspaceSearch" type="search" maxlength="200" placeholder="<%: L.T("Student.Dashboard.SearchWorkspace") %>" aria-controls="workspaceRecords" autocomplete="off" /><button type="button" class="sw-search-clear" aria-label="<%: L.T("Shared.SimpleWorkspace.ClearSearch") %>" hidden><span data-ui-icon="close" aria-hidden="true"></span></button></div>
 <output class="sw-search-count" aria-live="polite" data-search-count data-template="<%: L.T("Shared.SimpleWorkspace.MatchCount") %>" hidden></output>
</div>
<dl class="sw-metrics">
<div class="sw-metric"><dt><%: L.T("Student.Dashboard.Applications") %></dt><dd><asp:Literal ID="litApplications" runat="server" /></dd><small><%: L.T("Student.Dashboard.YourSubmittedApplications") %></small></div>
<div class="sw-metric"><dt><%: L.T("Student.Dashboard.TrainingTasks") %></dt><dd><asp:Literal ID="litTasks" runat="server" /></dd><small><%: L.T("Student.Dashboard.LinkedToYourPlacement") %></small></div>
<div class="sw-metric"><dt><%: L.T("Student.Dashboard.TasksEvaluated") %></dt><dd><asp:Literal ID="litEvaluations" runat="server" /></dd><small><%: L.T("Student.Dashboard.FeedbackAvailableToYou") %></small></div>
<div class="sw-metric"><dt><%: L.T("Student.Dashboard.ApprovedHours") %></dt><dd><asp:Literal ID="litHours" runat="server" /></dd><small><%: L.T("Student.Dashboard.PendingHoursAreSeparate") %></small></div>
</dl><div class="sw-layout"><div class="sw-main" id="workspaceRecords">
<section class="sw-panel" data-search-group><div class="sw-section-heading"><h2><%: L.T("Student.Dashboard.YourNextWork") %></h2><a href="MyTasks.aspx"><%: L.T("Student.Dashboard.OpenTasks") %> <span data-ui-icon="next" aria-hidden="true"></span></a></div>
<asp:Repeater ID="rptTasks" runat="server"><ItemTemplate><a class="sw-record" data-search-item href="MyTasks.aspx"><span class="sw-record-icon"><span data-ui-icon="document" aria-hidden="true"></span></span><span class="sw-record-copy"><strong><%#: Eval("Title") %></strong><small><%: L.T("Student.Dashboard.Due") %> <%#: Eval("DeadlineText") %></small></span><span class="badge"><%#: L.Value("TaskStatus", Eval("Status")) %></span><span data-ui-icon="next" aria-hidden="true"></span></a></ItemTemplate></asp:Repeater>
<asp:Panel ID="pnlNoTasks" runat="server" Visible="false" CssClass="sw-empty"><h3><%: L.T("Student.Dashboard.NoOpenTrainingTasks") %></h3><p><%: L.T("Student.Dashboard.TasksFromYourCompanySupervisorWill") %></p><a href="MyTasks.aspx"><%: L.T("Student.Dashboard.ViewYourTaskRecord") %></a></asp:Panel>
<p class="sw-empty" data-search-empty hidden><%: L.T("Shared.SimpleWorkspace.NoMatches") %></p></section><section class="sw-panel" data-search-group><div class="sw-section-heading"><h2><%: L.T("Student.Dashboard.ApplicationsPlacement") %></h2><a href="MyApplications.aspx"><%: L.T("Student.Dashboard.AllApplications") %> <span data-ui-icon="next" aria-hidden="true"></span></a></div>
<asp:Repeater ID="rptApplications" runat="server"><ItemTemplate><a class="sw-record" data-search-item href="MyApplications.aspx"><span class="sw-record-icon"><span data-ui-icon="briefcase" aria-hidden="true"></span></span><span class="sw-record-copy"><strong><%#: Eval("Title") %></strong><small><%#: Eval("Company") %> &#183; <%#: Eval("Date") %></small></span><span class="badge"><%#: L.Value("ApplicationStatus", Eval("Status")) %></span><span data-ui-icon="next" aria-hidden="true"></span></a></ItemTemplate></asp:Repeater>
<asp:Panel ID="pnlNoApplications" runat="server" Visible="false" CssClass="sw-empty"><p><%: L.T("Student.Dashboard.YouHaveNotSubmittedAnApplication") %></p><a href="Opportunities.aspx"><%: L.T("Student.Dashboard.FindAnEligibleOpportunity") %></a></asp:Panel>
<p class="sw-empty" data-search-empty hidden><%: L.T("Shared.SimpleWorkspace.NoMatches") %></p></section></div><aside class="sw-side">
<section class="sw-panel sw-hours"><div class="sw-section-heading"><h2><%: L.T("Student.Dashboard.TrainingHours") %></h2><span data-ui-icon="clock" aria-hidden="true"></span></div>
<div class="sw-hours-total"><%: Workspace == null ? "—" : Workspace.ApprovedHours.ToString() %><span><%: L.T("Student.Dashboard.ApprovedHours2") %></span></div>
<div class="sw-hours-target"><bdi dir="ltr"><asp:Literal ID="litProgressHours" runat="server" /></bdi><span><asp:Literal ID="litPercent" runat="server" /></span></div>
<div class="sw-progress"><div id="progressFill" runat="server" class="sw-progress-fill"></div></div>
<p class="sw-hours-pending"><strong><%: Workspace == null ? "—" : Workspace.PendingHours.ToString() %> <%: L.T("Workspace.UnitH") %></strong> <%: L.T("Student.Dashboard.AwaitingApproval") %></p>
<p><%: L.T("Student.Dashboard.OnlyApprovedEntriesCountTowardYour") %></p><a href="Progress.aspx"><%: L.T("Student.Dashboard.ViewHoursAndFeedback") %> <span data-ui-icon="next" aria-hidden="true"></span></a>
</section><nav class="sw-panel sw-workflows" aria-label="<%: L.T("Student.Dashboard.StudentResources") %>"><h2><%: L.T("Student.Dashboard.StudentResources") %></h2>
<a class="sw-workflow" href="Profile.aspx"><span class="sw-workflow-icon"><span data-ui-icon="person" aria-hidden="true"></span></span><span><strong><%: L.T("Student.Dashboard.YourProfile") %></strong><small><%: L.T("Student.Dashboard.ProfileHelp") %></small></span><span data-ui-icon="next" aria-hidden="true"></span></a>
<a class="sw-workflow" href="StudentCVPortfolio.aspx"><span class="sw-workflow-icon"><span data-ui-icon="document" aria-hidden="true"></span></span><span><strong><%: L.T("Student.Dashboard.CVPortfolio") %></strong><small><%: L.T("Student.Dashboard.DocumentsHelp") %></small></span><span data-ui-icon="next" aria-hidden="true"></span></a>
<a class="sw-workflow" href="../Meetings/MyMeetings.aspx"><span class="sw-workflow-icon"><span data-ui-icon="calendar" aria-hidden="true"></span></span><span><strong><%: L.T("Student.Dashboard.Meetings") %></strong><small><%: L.T("Student.Dashboard.MeetingsHelp") %></small></span><span data-ui-icon="next" aria-hidden="true"></span></a>
</nav></aside></div></div>
</asp:Content>
<asp:Content ID="Scripts" ContentPlaceHolderID="scripts" runat="server"><script src="<%: ResolveUrl("~/Assets/js/simple-workspace.js?v=20261024-1") %>"></script></asp:Content>
