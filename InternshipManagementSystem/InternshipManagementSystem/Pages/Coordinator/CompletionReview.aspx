<%@ Page Language="C#" MasterPageFile="~/Layout/Coordinator.master" AutoEventWireup="true" CodeBehind="CompletionReview.aspx.cs" Inherits="InternshipManagementSystem.Pages.CoordinatorArea.CompletionReview" Title="Final Completion Review" %>
<asp:Content ID="Head" ContentPlaceHolderID="head" runat="server">
<style>
.review-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.review-fact{border-top:1px solid var(--line);padding-top:.75rem}.review-fact small{display:block;color:var(--muted)}.review-fact strong{display:block;overflow-wrap:anywhere}.review-muted{color:var(--muted)}.review-comments{white-space:pre-wrap;overflow-wrap:anywhere}.review-actions{display:flex;flex-wrap:wrap;gap:.6rem}.review-verification{border-top:1px solid var(--line);padding:1rem 0}.review-verification label{display:block}.review-badge{display:inline-block;border:1px solid var(--line);border-radius:1rem;padding:.2rem .7rem}.review-grid input,.review-grid select{max-width:100%}@media(max-width:700px){.review-grid{grid-template-columns:1fr}}
</style>
</asp:Content>
<asp:Content ID="Body" ContentPlaceHolderID="MainContent" runat="server">
<h2><%: L.T("Coordinator.CompletionReview.FinalCompletionReview") %></h2>
<p class="review-muted"><%: L.T("Coordinator.CompletionReview.ReviewConfidentialEvaluationsAndVerifiedTraining") %></p>
<asp:Label ID="lblMessage" runat="server" Visible="false" role="alert" />
<section class="uims-card" aria-labelledby="queueHeading">
<h3 id="queueHeading"><%: L.T("Coordinator.CompletionReview.InternshipCompletionReviews") %></h3>
<p class="review-muted"><%: L.T("Coordinator.CompletionReview.WorkflowStatusesAreApplicationStatusesA") %></p>
<div class="review-grid mb-3">
<div><asp:Label runat="server" AssociatedControlID="txtSearch" Text="<%$ Resources:Coordinator, CompletionReview.SearchStudentNumberProgramOrCompany %>" /><asp:TextBox ID="txtSearch" runat="server" CssClass="form-control" MaxLength="150" /></div>
<div><asp:Label runat="server" AssociatedControlID="ddlStatus" Text="<%$ Resources:Coordinator, CompletionReview.CompletionReviewStatus %>" /><asp:DropDownList ID="ddlStatus" runat="server" CssClass="form-select"><asp:ListItem Value="" Text="<%$ Resources:Coordinator, Placements.AllStatuses %>" /><asp:ListItem Value="In Progress" Text="<%$ Resources:Coordinator, I18n.InProgress %>" /><asp:ListItem Value="Awaiting Evaluations" Text="<%$ Resources:Coordinator, I18n.AwaitingEvaluations %>" /><asp:ListItem Value="Ready for Review" Text="<%$ Resources:Coordinator, I18n.ReadyforReview %>" /><asp:ListItem Value="Needs Corrections" Text="<%$ Resources:Coordinator, I18n.NeedsCorrections %>" /><asp:ListItem Value="Approved" Text="<%$ Resources:Coordinator, CompletionReview.Approved %>" /><asp:ListItem Value="Rejected" Text="<%$ Resources:Coordinator, PlacementDetails.Rejected %>" /></asp:DropDownList></div>
</div><asp:Button ID="btnFilter" runat="server" Text="<%$ Resources:Coordinator, CompletionReview.ApplyFilters %>" CssClass="btn btn-outline-primary mb-3" OnClick="btnFilter_Click" CausesValidation="false" />
<div class="table-responsive"><table class="uims-table"><thead><tr><th scope="col"><%: L.T("Coordinator.CompletionReview.Student") %></th><th scope="col"><%: L.T("Coordinator.CompletionReview.StudentNumber") %></th><th scope="col"><%: L.T("Coordinator.CompletionReview.AcademicProgram") %></th><th scope="col"><%: L.T("Coordinator.CompletionReview.Company") %></th><th scope="col"><%: L.T("Coordinator.CompletionReview.InternshipType") %></th><th scope="col"><%: L.T("Coordinator.CompletionReview.TrainingStatus") %></th><th scope="col"><%: L.T("Coordinator.CompletionReview.EvaluationStatus") %></th><th scope="col"><%: L.T("Coordinator.CompletionReview.CompletionReviewStatus") %></th><th scope="col"><%: L.T("Coordinator.CompletionReview.Review") %></th></tr></thead><tbody>
<asp:Repeater ID="rptPlacements" runat="server"><ItemTemplate><tr><td><%#: Eval("StudentName") %></td><td><%#: Eval("StudentNumber") %></td><td><%#: Eval("Program") %></td><td><%#: Eval("Company") %></td><td><%#: Eval("InternshipType") %></td><td><%#: Eval("TrainingStatus") %></td><td><%#: Eval("EvaluationStatus") %></td><td><span class="review-badge"><%#: L.Value("Ui", Eval("Status")) %></span></td><td><asp:HyperLink runat="server" NavigateUrl='<%# Eval("ReviewUrl") %>' Text="<%$ Resources:Coordinator, CompletionReview.ViewDetails %>" /></td></tr></ItemTemplate></asp:Repeater>
</tbody></table></div><asp:Panel ID="pnlNoPlacements" runat="server" Visible="false"><p><%: L.T("Coordinator.CompletionReview.NoInternshipsMatchTheseFilters") %></p></asp:Panel>
</section>
<asp:Panel ID="pnlSelect" runat="server" CssClass="uims-card"><h3><%: L.T("Coordinator.CompletionReview.SelectAStudent") %></h3><p><%: L.T("Coordinator.CompletionReview.UseViewDetailsToReviewAn") %></p></asp:Panel>
<asp:Panel ID="pnlReview" runat="server" Visible="false">
<section class="uims-card"><h3><%: L.T("Coordinator.CompletionReview.StudentInternshipInformation") %></h3><h4><asp:Literal ID="litStudent" runat="server" /></h4><div class="review-grid"><asp:Literal ID="litFacts" runat="server" /></div></section>
<section class="uims-card"><h3><%: L.T("Coordinator.CompletionReview.EvaluationEvidence") %></h3><p class="review-muted"><%: L.T("Coordinator.CompletionReview.FinalSupervisorEvaluationsAndCommentsAre") %></p><div class="review-grid"><div><h4><%: L.T("Coordinator.CompletionReview.CompanyFinalEvaluation2") %></h4><asp:Literal ID="litCompanyEvidence" runat="server" /><p class="review-comments"><asp:Literal ID="litCompanyComments" runat="server" /></p></div><div><h4><%: L.T("Coordinator.CompletionReview.AcademicFinalEvaluation2") %></h4><asp:Literal ID="litAcademicEvidence" runat="server" /><p class="review-comments"><asp:Literal ID="litAcademicComments" runat="server" /></p></div></div><asp:Literal ID="litTasks" runat="server" /></section>
<section class="uims-card"><h3><%: L.T("Coordinator.CompletionReview.TrainingRequirementsDocuments") %></h3><asp:Literal ID="litRule" runat="server" /><asp:Panel ID="pnlConfiguration" runat="server"><asp:Label runat="server" AssociatedControlID="ddlRule" Text="<%$ Resources:Coordinator, CompletionReview.ApplicableEvaluationAndTrainingRule %>" /><asp:DropDownList ID="ddlRule" runat="server" CssClass="form-select mb-2" /><asp:Button ID="btnRule" runat="server" Text="<%$ Resources:Coordinator, CompletionReview.SaveReviewConfiguration %>" CssClass="btn btn-outline-primary" OnClick="btnRule_Click" CausesValidation="false" /><p class="review-muted"><%: L.T("Coordinator.CompletionReview.SelectTheActualInternshipTypeChanging") %></p></asp:Panel><asp:Literal ID="litIssues" runat="server" /></section>
<section class="uims-card"><h3><%: L.T("Coordinator.CompletionReview.CoordinatorVerification") %></h3><p><%: L.T("Coordinator.CompletionReview.InspectTheSupportingRecordsBeforeConfirming") %></p>
<asp:Repeater ID="rptRequirements" runat="server"><ItemTemplate><div class="review-verification"><asp:HiddenField ID="requirementKey" runat="server" Value='<%# Eval("Key") %>' /><asp:CheckBox ID="confirmed" runat="server" Checked='<%# Eval("Confirmed") %>' Enabled='<%# Eval("Editable") %>' Text='<%# Server.HtmlEncode((string)Eval("Label")) %>' /><p class="review-muted"><%#: Eval("Source") %></p><asp:Label runat="server" AssociatedControlID="evidenceReference" Text="<%$ Resources:Coordinator, CompletionReview.SupportingEvidenceReference %>" /><asp:TextBox ID="evidenceReference" runat="server" CssClass="form-control" Text='<%# Eval("Reference") %>' MaxLength="1000" Enabled='<%# Eval("Editable") %>' /><asp:Panel runat="server" Visible='<%# Eval("NeedsDate") %>'><asp:Label runat="server" AssociatedControlID="evidenceDate" Text="<%$ Resources:Coordinator, CompletionReview.DateOfSchoolApprovalBeforeTraining %>" /><asp:TextBox ID="evidenceDate" runat="server" TextMode="Date" CssClass="form-control" Text='<%# Eval("Date") %>' Enabled='<%# Eval("Editable") %>' /></asp:Panel><p class="review-muted"><%#: Eval("Audit") %></p></div></ItemTemplate></asp:Repeater>
<asp:Button ID="btnVerify" runat="server" Text="<%$ Resources:Coordinator, CompletionReview.SaveEvidenceVerification %>" CssClass="btn btn-outline-primary" OnClick="btnVerify_Click" CausesValidation="false" /></section>
<section class="uims-card"><h3><%: L.T("Coordinator.CompletionReview.FinalDecision") %></h3><p><%: L.T("Coordinator.CompletionReview.FinalCompletionStatus") %> <strong><asp:Literal ID="litReviewStatus" runat="server" /></strong></p><p><%: L.T("Coordinator.CompletionReview.ProvisionalEvaluationResult") %> <strong><asp:Literal ID="litProposedResult" runat="server" /></strong></p><asp:Panel ID="pnlInternalScore" runat="server"><p><%: L.T("Coordinator.CompletionReview.InternalConfiguredScore") %> <asp:Literal ID="litInternalScore" runat="server" /></p></asp:Panel><p class="review-muted"><%: L.T("Coordinator.CompletionReview.APassingEvaluationDoesNotApprove") %></p><asp:Literal ID="litSavedNote" runat="server" />
<asp:Panel ID="pnlDecision" runat="server"><asp:Label runat="server" AssociatedControlID="txtCoordinatorNote" Text="<%$ Resources:Coordinator, CompletionReview.CoordinatorNoteRequiredForCorrectionsOr %>" /><asp:TextBox ID="txtCoordinatorNote" runat="server" CssClass="form-control mb-3" TextMode="MultiLine" Rows="3" MaxLength="2000" /><div class="review-actions"><asp:Button ID="btnApprove" runat="server" Text="<%$ Resources:Coordinator, CompletionReview.ApproveInternshipCompletion %>" CssClass="btn btn-brand" OnClick="btnApprove_Click" CausesValidation="false" data-i18n-confirm="<%$ Resources:Shared, I18n.Approvecompletionandreleasethestudentreport %>" OnClientClick="return confirm(this.getAttribute('data-i18n-confirm'));" /><asp:Button ID="btnCorrections" runat="server" Text="<%$ Resources:Coordinator, CompletionReview.ReturnForCorrections %>" CssClass="btn btn-outline-primary" OnClick="btnCorrections_Click" CausesValidation="false" /><asp:Button ID="btnReject" runat="server" Text="<%$ Resources:Coordinator, CompletionReview.RejectCompletion %>" CssClass="btn btn-outline-danger" OnClick="btnReject_Click" CausesValidation="false" data-i18n-confirm="<%$ Resources:Shared, I18n.RejectcompletionwiththedocumentedreasonThis %>" OnClientClick="return confirm(this.getAttribute('data-i18n-confirm'));" /></div></asp:Panel>
</section>
<asp:Panel ID="pnlDownloads" runat="server" CssClass="uims-card" Visible="false"><h3><%: L.T("Coordinator.CompletionReview.ApprovedDocuments") %></h3><p><%: L.T("Coordinator.CompletionReview.TheReportIsReleasedToThe") %></p><asp:HyperLink ID="lnkReport" runat="server" Text="<%$ Resources:Coordinator, CompletionReview.DownloadInternshipCompletionReport %>" CssClass="btn btn-outline-primary" /><asp:HyperLink ID="lnkCertificate" runat="server" Text="<%$ Resources:Coordinator, CompletionReview.GenerateInternshipCompletionCertificate %>" CssClass="btn btn-outline-primary" /></asp:Panel>
<section class="uims-card"><h3><%: L.T("Coordinator.CompletionReview.ReviewHistory") %></h3><asp:Literal ID="litAudit" runat="server" /></section>
</asp:Panel>
</asp:Content>
