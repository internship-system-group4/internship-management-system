<%@ Page CodePage="65001" Language="C#" MasterPageFile="~/Layout/Company.master" AutoEventWireup="true" CodeBehind="Account.aspx.cs" Inherits="InternshipManagementSystem.Pages.CompanyArea.Account" Title="My Account" %>
<asp:Content ID="Head" ContentPlaceHolderID="head" runat="server"></asp:Content>
<asp:Content ID="Body" ContentPlaceHolderID="MainContent" runat="server">
<div class="su-account">
<header class="su-account-heading"><div><h1><%: L.T("Shared.SupervisorAccount.Title") %></h1><p><%: L.T("Shared.SupervisorAccount.Intro") %></p></div></header>
<div class="su-account-layout"><aside class="su-account-summary" aria-labelledby="accountName"><div class="su-account-avatar-wrap"><asp:Image ID="imgAvatar" runat="server" CssClass="su-account-avatar" Visible="false" AlternateText="<%$ Resources:Company, Account.ProfilePicture %>" /><div id="divInitials" runat="server" class="su-account-avatar"><asp:Literal ID="litInitials" runat="server" Mode="Encode">SU</asp:Literal></div><button type="button" class="su-account-photo-action" data-bs-toggle="modal" data-bs-target="#editProfileModal" aria-label="<%: L.T("Company.Account.ProfilePicture") %>"><span data-ui-icon="camera" aria-hidden="true"></span></button></div><div class="su-account-identity"><h2 id="accountName"><asp:Literal ID="litDisplayName" runat="server" Mode="Encode" Text="<%$ Resources:Company, Account.SupervisorNamePlaceholder %>" /></h2><span class="badge bg-info"><%: L.T("Shared.Role.CompanySupervisor") %></span></div><div class="su-account-actions"><button type="button" class="btn btn-brand" data-bs-toggle="modal" data-bs-target="#editProfileModal"><span data-ui-icon="edit" aria-hidden="true"></span><%: L.T("Shared.SupervisorAccount.EditProfile") %></button><a class="btn btn-outline-secondary" href="../Account/ChangePassword.aspx"><%: L.T("Academic.Account.ChangePassword") %></a></div></aside><div class="su-account-main"><section class="su-account-section" aria-labelledby="accountContactTitle"><header class="su-account-section-heading"><span data-ui-icon="person" aria-hidden="true"></span><div><h2 id="accountContactTitle"><%: L.T("Shared.SupervisorAccount.PersonalTitle") %></h2><p><%: L.T("Shared.SupervisorAccount.PersonalHelp") %></p></div></header><dl class="su-account-facts"><div class="su-account-fact"><dt><%: L.T("Company.Account.EmailAddressReadOnly") %></dt><dd><span data-ui-icon="mail" aria-hidden="true"></span><bdi><asp:Literal ID="litEmail" runat="server" Mode="Encode" /></bdi></dd></div><div class="su-account-fact"><dt><%: L.T("Company.Account.PhoneNumber") %></dt><dd><span data-ui-icon="phone" aria-hidden="true"></span><bdi><asp:Literal ID="litPhone" runat="server" Mode="Encode" Text="<%$ Resources:Company, Account.NotProvided %>" /></bdi></dd></div><div class="su-account-fact"><dt><%: L.T("Company.Account.JobTitleDepartment") %></dt><dd><span data-ui-icon="briefcase" aria-hidden="true"></span><asp:Literal ID="litJobTitle" runat="server" Mode="Encode" Text="<%$ Resources:Company, Account.NotProvided %>" /></dd></div></dl></section>
<section class="su-account-section" aria-labelledby="accountOrganizationTitle"><header class="su-account-section-heading"><span data-ui-icon="building" aria-hidden="true"></span><div><h2 id="accountOrganizationTitle"><%: L.T("Shared.SupervisorAccount.OrganizationTitle") %></h2><p><%: L.T("Shared.SupervisorAccount.OrganizationHelp") %></p></div></header><dl class="su-account-facts"><div class="su-account-fact"><dt><%: L.T("Company.Account.CompanyAssociationReadOnly") %></dt><dd><span data-ui-icon="building" aria-hidden="true"></span><asp:Literal ID="litCompany" runat="server" Mode="Encode" /></dd></div></dl></section></div></div>
</div>
<div class="modal fade su-account-modal" id="editProfileModal" tabindex="-1" aria-labelledby="accountEditTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
 <div class="modal-header"><h2 class="modal-title" id="accountEditTitle"><%: L.T("Shared.SupervisorAccount.EditProfile") %></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%: L.T("Company.Account.Close") %>"></button></div>
 <div class="modal-body">
 <div class="mb-3"><label for="<%= fuProfileImage.ClientID %>"><%: L.T("Company.Account.ProfilePicture") %></label><asp:FileUpload ID="fuProfileImage" runat="server" accept=".png,.jpg,.jpeg" CssClass="su-account-file" aria-describedby="accountPhotoHint" /><p class="form-text" id="accountPhotoHint"><%: L.T("Company.Account.JPGOrPNGAllowed") %></p></div>
 <div class="mb-3"><asp:Label runat="server" AssociatedControlID="txtFullName" Text="<%$ Resources:Company, Account.FullName %>" /><asp:TextBox ID="txtFullName" runat="server" CssClass="form-control" autocomplete="name" /></div>
 <div class="mb-3"><asp:Label runat="server" AssociatedControlID="txtPhone" Text="<%$ Resources:Company, Account.PhoneNumber %>" /><asp:TextBox ID="txtPhone" runat="server" CssClass="form-control" TextMode="Phone" autocomplete="tel" /></div>
 <div class="mb-3"><asp:Label runat="server" AssociatedControlID="txtJobTitle" Text="<%$ Resources:Company, Account.JobTitleDepartment %>" /><asp:TextBox ID="txtJobTitle" runat="server" CssClass="form-control" placeholder="<%$ Resources:Company, Account.EGHRManager %>" /></div>
 </div>
 <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal"><%: L.T("Company.Account.Cancel") %></button><asp:Button ID="btnSaveChanges" runat="server" Text="<%$ Resources:Company, Account.SaveChanges %>" CssClass="btn btn-brand" OnClick="BtnSaveChanges_Click" data-ui-action="save" data-loading-label="<%$ Resources:Shared, I18n.Saving %>" /></div>
</div></div></div>
    <div class="modal fade" id="serverMessageModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow text-center p-4">
          <div class="mb-3"><asp:Literal ID="litModalIcon" runat="server"></asp:Literal></div>
          <h5 class="fw-bold mb-2 text-dark"><asp:Literal ID="litModalTitle" runat="server"></asp:Literal></h5>
          <p class="text-muted small mb-4"><asp:Literal ID="litModalMessage" runat="server"></asp:Literal></p>
          <button type="button" class="btn btn-primary rounded-pill px-4 w-100" data-bs-dismiss="modal" style="background-color: var(--ui-primary); border: none;"><%: L.T("Company.Account.Okay") %></button>
        </div>
      </div>
    </div>


</asp:Content>
