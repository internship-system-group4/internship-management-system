<?xml version="1.0" encoding="utf-8"?>
<!--
  UIMS - Group 4

  Firebase settings for the whole team's shared Firebase project. They live
  here, in Git, so every teammate gets them with a normal git pull and no
  extra setup file is needed.

  The Web API key is not a password: Firebase expects it to be visible in app
  code. The data is protected by the Realtime Database rules
  (see docs/05-firebase-setup.md).
-->
<configuration>

  <appSettings>
    <add key="Firebase.DatabaseUrl" value="https://poject1000-1454c-default-rtdb.firebaseio.com" />
    <add key="Firebase.ApiKey" value="AIzaSyDsB5LANNZbfXnfq9bdKmP9pC5ghjLBngY" />
    <add key="Firebase.StorageBucket" value="" />
    <!-- Speed: a user's Firebase reads are reused for this many seconds.
         Any save made through this app clears them at once, so everyone using
         this server sees changes immediately. Changes saved from ANOTHER
         running copy of the app (a teammate's laptop) or typed in the Firebase
         console can take up to this long to appear here. Form submits always
         re-check the signed-in account with Firebase.
         0 turns the reuse between pages off. -->
    <add key="Firebase.ReadCacheSeconds" value="30" />
    <add key="Zoom.AccountId" value="" />
    <add key="Zoom.ClientId" value="" />
    <add key="Zoom.ClientSecret" value="" />
    <add key="Zoom.HostEmail" value="" />
    <!-- In-app notifications are created by Services/NotificationService.
         Notifications.Enabled=true would make the older email dispatcher store
         a second copy of each one, so keep it false. Email.Enabled sends email
         (configure SMTP and the public app URL in App_Secrets.config first). -->
    <add key="Notifications.Enabled" value="false" />
    <add key="Email.Enabled" value="false" />
    <add key="Email.ApplicationUrl" value="" />
    <add key="Email.FromAddress" value="" />
    <add key="Email.FromName" value="University Internship Management System" />
    <add key="Email.SmtpHost" value="" />
    <add key="Email.SmtpPort" value="587" />
    <add key="Email.EnableSsl" value="true" />
    <add key="Email.SmtpUsername" value="" />
    <add key="Email.SmtpPassword" value="" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" maxRequestLength="12288" requestValidationMode="4.5" />

    <!-- Sign-in is our own: a verified Firebase account kept in Session and
         checked by Security/SecurePage.cs. ASP.NET's own Forms authentication
         is not used, so it stays off. -->
    <authentication mode="None" />

    <sessionState mode="InProc" timeout="60" cookieless="UseCookies" />

    <httpCookies httpOnlyCookies="true" requireSSL="false" />

    <!-- Leave RemoteOnly while developing so real errors are visible locally.
         Before the demo, point defaultRedirect at a friendly page. -->
    <customErrors mode="RemoteOnly" />

    <pages enableViewStateMac="true" validateRequest="true">
      <namespaces>
        <add namespace="InternshipManagementSystem.Common" />
        <add namespace="InternshipManagementSystem.Models" />
      </namespaces>
    </pages>
  </system.web>

  <system.webServer>
    <!-- Internal execution preserves the missing URL and the 404 status. For an IIS
         sub-application, prefix this server-relative path with its application alias. -->
    <httpErrors errorMode="Custom" existingResponse="Auto">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" subStatusCode="-1" path="/Pages/Public/NotFound.aspx" responseMode="ExecuteURL" />
    </httpErrors>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <!-- Seated figures for the Powered by lecture hall (Assets/models/people). -->
    <staticContent>
      <remove fileExtension=".glb" />
      <mimeMap fileExtension=".glb" mimeType="model/gltf-binary" />
      <!-- MapLibre GL JS ships as ES modules (footer campus map). -->
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <!-- WebP copy of the Login campus photograph (PNG kept as the <picture> fallback). -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>

  <!-- Missing error-page assets stay ordinary failed resource responses. Never
       execute the HTML error page recursively for its own CSS, scripts or fonts. -->
  <location path="Assets">
    <system.webServer>
      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </location>

  <!-- Long browser caching only where a changed file gets a new name: character models (e.g. *.web.glb),
       the university photographs and material maps, and the web fonts. Scripts and stylesheets keep ETag
       revalidation, because some ES-module imports carry no version query. Rule: never overwrite a file here in place;
       publish it under a new name and update the reference. -->
  <location path="Assets/models">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="Assets/images/university">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="Assets/fonts">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
    </compilers>
  </system.codedom>

</configuration>
